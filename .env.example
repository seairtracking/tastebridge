# Copy to .env and fill in. Never commit .env.
# Hackathon key from the Qloo Agentic Hackathon welcome email.
QLOO_API_KEY=your_qloo_hackathon_key
QLOO_API_URL=https://hackathon.api.qloo.com
PORT=8787
# Where accounts and two-phone rooms are stored (outside the code folder in production)
TASTEBRIDGE_DB=./data/tastebridge.db
